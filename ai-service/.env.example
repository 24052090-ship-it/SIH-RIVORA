VISION_MODEL_PATH=ai-service/models/aquaguard_yolo.pt
VISION_MODEL_VERSION=aquaguard-yolo-custom-v1
VISION_CONFIDENCE=0.25

# Base checkpoint used by scripts/train_yolo.py before fine-tuning on AquaGuard
# labels. Must be a valid Ultralytics checkpoint name (e.g. yolo11n.pt) or a
# local path to an approved pretrained weights file.
AQUAGUARD_YOLO_BASE_MODEL=yolo11n.pt
