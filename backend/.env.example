AI_SERVICE_URL=http://localhost:8000

VISION_MAX_BYTES=10485760

# Socket.IO
SOCKET_ENABLED=true

# Phase 8 satellite integration
SATELLITE_ENABLED=false
SATELLITE_PROVIDER=sentinel-hub
SATELLITE_COLLECTION=sentinel-2-l2a
