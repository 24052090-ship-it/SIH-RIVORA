DEVICE_REQUIRE_TLS=false
DEVICE_MAX_CLOCK_SKEW_MS=300000
DEVICE_MAX_BUFFER_AGE_MS=604800000
WEATHER_SYNC_ENABLED=true
WEATHER_SYNC_INTERVAL_MS=900000
