PORT=5000
DATABASE_URL=postgresql://aquaguard:aquaguard@localhost:5432/aquaguard
JWT_SECRET=change-this-in-production
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0
