VITE_API_BASE_URL=http://localhost:5000/api
VITE_USE_MOCK_DATA=false
VITE_ENABLE_REALTIME=true
VITE_SOCKET_URL=http://localhost:5000
VITE_ENABLE_AI=false
VITE_AI_SERVICE_URL=http://localhost:8000
VITE_ENABLE_IOT=true
VITE_MAP_PROVIDER=osm

# Satellite / geospatial intelligence (Phase 8)
VITE_ENABLE_SATELLITE=false
VITE_SATELLITE_PROVIDER=sentinel-hub
VITE_SATELLITE_COLLECTION=sentinel-2-l2a
VITE_SATELLITE_TILE_URL=
VITE_SATELLITE_ATTRIBUTION=Satellite imagery provider

# Production hardening (Phase 9)
NODE_ENV=development
