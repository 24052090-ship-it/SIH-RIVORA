{
  "name": "aquaguard-frontend",
  "private": true,
  "version": "31.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "backend:dev": "npm --prefix backend run dev",
    "backend:start": "npm --prefix backend start",
    "backend:init": "npm --prefix backend run db:init",
    "backend:seed": "npm --prefix backend run db:seed",
    "backend:migrate": "npm --prefix backend run db:migrate",
    "simulate:sensor": "node scripts/simulate-sensor.js",
    "ai:train": "python ai-service/scripts/train_model.py",
    "ai:dev": "python -m uvicorn app.main:app --app-dir ai-service --reload --port 8000",
    "ai:vision-train": "python ai-service/scripts/train_yolo.py",
    "ai:vision-validate": "python ai-service/scripts/validate_yolo.py",
    "simulate:realtime": "node scripts/simulate-realtime.js",
    "health:check": "node scripts/final-health-check.js",
    "smoke:test": "node scripts/smoke-test.js",
    "readiness:test": "node scripts/readiness-test.js",
    "validation:test": "node scripts/validate-data.js",
    "mlops:test": "node scripts/mlops-test.js",
    "ingestion:test": "node scripts/ingestion-test.js",
    "demo:scenario": "node scripts/demo-scenario.js",
    "incident:test": "node scripts/incident-test.js",
    "broadcast:test": "node scripts/broadcast-test.js",
    "operations:test": "node scripts/operations-test.js",
    "fieldops:test": "node scripts/field-operations-test.js",
    "fieldmobile:test": "node scripts/field-mobile-test.js",
    "data:validate": "node scripts/validate-imports.cjs",
    "data:integration:test": "node scripts/data-integration-test.js",
    "demo": "vite --mode demo",
    "build:demo": "vite build --mode demo",
    "ai:train-real": "python ai-service/scripts/train-flood-real.py",
    "ai:evaluate-real": "python ai-service/scripts/evaluate-flood-real.py",
    "ai:vision-train-real": "python ai-service/scripts/train-yolo-real.py",
    "ai:vision-validate-real": "python ai-service/scripts/validate-yolo-real.py",
    "phase28:test": "node scripts/phase28-validation.js",
    "phase29:audit": "python scripts/production-preflight.py",
    "phase29:preflight": "python scripts/production-preflight.py --production",
    "phase29:backup-restore": "python scripts/phase29-backup-restore.py",
    "phase30:check": "python scripts/final-release-check.py",
    "phase30:demo": "node scripts/demo-scenario.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "axios": "latest",
    "leaflet": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-leaflet": "latest",
    "react-router-dom": "latest",
    "recharts": "latest",
    "vite": "latest",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {}
}
